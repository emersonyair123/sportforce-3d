<?xml version="1.0" encoding="UTF-8"?>

<?import com.sportforce3d.component.PpqhSfLink?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportforce3d.view.HepyAdminProductEditController"
            fitToWidth="true" styleClass="sf-page">
    <VBox spacing="24" maxWidth="1180">
        <padding><Insets top="24" right="24" bottom="64" left="24"/></padding>
        <PpqhSfLink fx:id="hepyBackLink" id="backLink" text="Productos"/>
        <Label fx:id="hepyTitle" id="title" text="NUEVO PRODUCTO" styleClass="display-l, ink" wrapText="true"/>
        <VBox fx:id="hepyContent" id="content" spacing="24"/>
    </VBox>
</ScrollPane>
