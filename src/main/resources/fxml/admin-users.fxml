<?xml version="1.0" encoding="UTF-8"?>

<?import com.sportforce3d.component.PpqhSfButton?>
<?import com.sportforce3d.component.PpqhSfTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sportforce3d.view.PpqhAdminUsersController"
      spacing="24" styleClass="sf-page">
    <padding><Insets top="32" right="24" bottom="24" left="24"/></padding>

    <VBox spacing="8">
        <Label text="USUARIOS" styleClass="display-l, ink"/>
        <Label text="Activa o desactiva cuentas y asigna el rol de administrador. Cada cambio se valida con tu rol ADMIN."
               styleClass="body-s, ink-muted" wrapText="true"/>
    </VBox>

    <HBox spacing="12" alignment="BOTTOM_LEFT">
        <PpqhSfTextField fx:id="ppqhFilterField" id="filterField" label="Buscar" promptText="Nombre o correo" prefWidth="320"/>
        <Region HBox.hgrow="ALWAYS"/>
        <PpqhSfButton fx:id="ppqhRefreshButton" id="refreshButton" text="Actualizar" variant="GHOST" size="MD"/>
    </HBox>

    <StackPane VBox.vgrow="ALWAYS">
        <TableView fx:id="ppqhTable" id="table"/>
    </StackPane>
</VBox>
