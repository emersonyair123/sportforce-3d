<?xml version="1.0" encoding="UTF-8"?>

<?import com.sportforce3d.component.PpqhLogo?>
<?import com.sportforce3d.component.PpqhSfButton?>
<?import com.sportforce3d.component.PpqhSfLink?>
<?import com.sportforce3d.component.PpqhSfTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportforce3d.view.PpqhRegisterController"
            fitToWidth="true" fitToHeight="true" styleClass="sf-page">
    <StackPane>
        <padding><Insets top="32" right="24" bottom="32" left="24"/></padding>
        <VBox styleClass="sf-auth-panel" maxWidth="480" maxHeight="-Infinity">
            <PpqhLogo fontSize="24"/>
            <Label text="Crea tu cuenta" styleClass="heading-m, ink"/>
            <Label text="Guarda tus diseños 3D y sigue tus pedidos desde un solo lugar."
                   styleClass="body-s, ink-muted" wrapText="true"/>

            <HBox fx:id="ppqhErrorBox" id="errorBox" styleClass="sf-alert-error">
                <Label fx:id="ppqhErrorLabel" id="errorLabel" wrapText="true"/>
            </HBox>

            <PpqhSfTextField fx:id="ppqhFullNameField" id="fullNameField" label="Nombre completo" promptText="Lucía Quispe"/>
            <PpqhSfTextField fx:id="ppqhEmailField" id="emailField" label="Correo" promptText="nombre@correo.com"/>
            <PpqhSfTextField fx:id="ppqhPhoneField" id="phoneField" label="Celular (opcional)" promptText="987654321"/>
            <PpqhSfTextField fx:id="ppqhPasswordField" id="passwordField" label="Contraseña" password="true"/>
            <PpqhSfTextField fx:id="ppqhConfirmationField" id="confirmationField" label="Repite la contraseña" password="true"/>

            <PpqhSfButton fx:id="ppqhRegisterButton" id="registerButton" text="Crear cuenta" variant="PRIMARY" size="MD"
                      maxWidth="Infinity" defaultButton="true"/>

            <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="¿Ya tienes cuenta?" styleClass="body-s, ink-muted"/>
                <PpqhSfLink fx:id="ppqhLoginLink" id="loginLink" text="Inicia sesión"/>
            </HBox>
        </VBox>
    </StackPane>
</ScrollPane>
