<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sportforce3d.view.AdminDashboardController"
            fitToWidth="true" styleClass="sf-page">
    <VBox spacing="24" maxWidth="1180">
        <padding><Insets top="32" right="24" bottom="64" left="24"/></padding>
        <VBox spacing="8">
            <Label text="DASHBOARD" styleClass="display-l, ink"/>
            <Label fx:id="subtitle" styleClass="body-s, ink-muted" wrapText="true"/>
        </VBox>
        <VBox fx:id="content" spacing="24"/>
    </VBox>
</ScrollPane>
