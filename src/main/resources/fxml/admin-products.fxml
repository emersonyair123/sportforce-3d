<?xml version="1.0" encoding="UTF-8"?>

<?import com.sportforce3d.component.SfButton?>
<?import com.sportforce3d.component.SfTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.sportforce3d.view.AdminProductsController"
      spacing="24" styleClass="sf-page">
    <padding><Insets top="32" right="24" bottom="24" left="24"/></padding>

    <VBox spacing="8">
        <Label text="PRODUCTOS" styleClass="display-l, ink"/>
        <Label text="Crea y edita productos, variantes, precios, materiales e imágenes. Eliminar es lógico: los pedidos antiguos conservan sus datos."
               styleClass="body-s, ink-muted" wrapText="true"/>
    </VBox>

    <HBox spacing="16" alignment="BOTTOM_LEFT">
        <SfTextField fx:id="filterField" label="Buscar" promptText="Nombre o SKU" prefWidth="320"/>
        <CheckBox fx:id="deletedCheck" text="Mostrar eliminados">
            <HBox.margin><Insets bottom="12"/></HBox.margin>
        </CheckBox>
        <Region HBox.hgrow="ALWAYS"/>
        <SfButton fx:id="newButton" text="Nuevo producto" variant="PRIMARY" size="MD"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
</VBox>
